@prefix dash:   <http://datashapes.org/dash#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix shapes: <https://shacl-play.sparna.fr/shapes/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

shapes:Restaurant_has_address
        sh:class     <http://www.okkam.org/ontology_restaurant1.owl#Address> ;
        sh:maxCount  1 ;
        sh:minCount  1 ;
        sh:name      "has_address"@en ;
        sh:nodeKind  sh:IRI ;
        sh:path      <http://www.okkam.org/ontology_restaurant1.owl#has_address> .

shapes:Restaurant  rdf:type  sh:NodeShape ;
        rdfs:label      "Restaurant"@en ;
        sh:property     shapes:Restaurant_name , shapes:Restaurant_phone_number , shapes:Restaurant_category , shapes:Restaurant_has_address ;
        sh:targetClass  <http://www.okkam.org/ontology_restaurant1.owl#Restaurant> .

shapes:Restaurant_name
        sh:datatype  xsd:string ;
        sh:maxCount  1 ;
        sh:minCount  1 ;
        sh:name      "name"@en ;
        sh:nodeKind  sh:Literal ;
        sh:path      <http://www.okkam.org/ontology_restaurant1.owl#name> .

shapes:Address_is_in_city
        sh:class     <http://www.okkam.org/ontology_restaurant1.owl#City> ;
        sh:maxCount  1 ;
        sh:minCount  1 ;
        sh:name      "is_in_city"@en ;
        sh:nodeKind  sh:IRI ;
        sh:path      <http://www.okkam.org/ontology_restaurant1.owl#is_in_city> .

shapes:Restaurant_phone_number
        sh:datatype  xsd:string ;
        sh:maxCount  1 ;
        sh:minCount  1 ;
        sh:name      "phone_number"@en ;
        sh:nodeKind  sh:Literal ;
        sh:path      <http://www.okkam.org/ontology_restaurant1.owl#phone_number> .

shapes:Restaurant_category
        sh:datatype  xsd:string ;
        sh:in        ( "american" "delicatessen" "international" "french" "italian" "mediterranean" "steak houses" "asian" "mexican" "continental" "seafood" "californian" "caribbean" "southwestern" "coffee bar" "tel caribbean" "southern" "or 212/632-5100 american" "ext 6108 international" ) ;
        sh:maxCount  1 ;
        sh:minCount  1 ;
        sh:name      "category"@en ;
        sh:nodeKind  sh:Literal ;
        sh:path      <http://www.okkam.org/ontology_restaurant1.owl#category> .

shapes:Address_street
        dash:propertyRole  dash:LabelRole ;
        sh:datatype        xsd:string ;
        sh:maxCount        1 ;
        sh:minCount        1 ;
        sh:name            "street"@en ;
        sh:nodeKind        sh:Literal ;
        sh:path            <http://www.okkam.org/ontology_restaurant1.owl#street> .

shapes:City  rdf:type   sh:NodeShape ;
        rdfs:label      "City"@en ;
        sh:property     shapes:City_name ;
        sh:targetClass  <http://www.okkam.org/ontology_restaurant1.owl#City> .

<https://shacl-play.sparna.fr/shapes>
        rdf:type  <http://www.w3.org/2002/07/owl#Ontology> ;
        <http://purl.org/dc/terms/abstract>
                "Generated by SHACL Play!"@en ;
        <http://purl.org/dc/terms/created>
                "2025-03-08T08:28:53.264Z"^^xsd:dateTime .

shapes:Address  rdf:type  sh:NodeShape ;
        rdfs:label      "Address"@en ;
        sh:property     shapes:Address_street , shapes:Address_is_in_city ;
        sh:targetClass  <http://www.okkam.org/ontology_restaurant1.owl#Address> .

shapes:City_name  dash:propertyRole  dash:LabelRole ;
        sh:datatype        xsd:string ;
        sh:in              ( "san francisco" "atlanta" "sherman oaks" "new york" "las vegas" "studio city" "los angeles" "brooklyn" "malibu" "hollywood" "bel air" "santa monica" "beverly hills" ) ;
        sh:maxCount        1 ;
        sh:minCount        1 ;
        sh:name            "name"@en ;
        sh:nodeKind        sh:Literal ;
        sh:path            <http://www.okkam.org/ontology_restaurant1.owl#name> .