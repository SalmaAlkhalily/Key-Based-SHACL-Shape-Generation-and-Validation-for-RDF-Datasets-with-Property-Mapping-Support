PREFIX sh:  <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<Shape7>  a          sh:NodeShape;
        sh:property  [ sh:datatype  xsd:string;
                       sh:maxCount  "1"^^xsd:int;
                       sh:path      <street>
                     ];
        sh:property  [ sh:datatype  xsd:string;
                       sh:maxCount  "1"^^xsd:int;
                       sh:path      <category>
                     ];
        sh:severity  sh:Violation;
        sh:sparql    [ a           sh:SPARQLConstraint;
                       sh:message  "Duplicate detected for properties: http://www.okkam.org/ontology_restaurant1.owl#category, http://www.okkam.org/ontology_restaurant1.owl#street";
                       sh:select   "SELECT ?this\nWHERE {\n        ?this ex:http://www.okkam.org/ontology_restaurant1.owl#category ?http://www.okkam.org/ontology_restaurant1.owl#category .\n    ?other ex:http://www.okkam.org/ontology_restaurant1.owl#category ?http://www.okkam.org/ontology_restaurant1.owl#category .\n    ?this ex:http://www.okkam.org/ontology_restaurant1.owl#street ?http://www.okkam.org/ontology_restaurant1.owl#street .\n    ?other ex:http://www.okkam.org/ontology_restaurant1.owl#street ?http://www.okkam.org/ontology_restaurant1.owl#street .\n\n    FILTER (?this != ?other)\n}\n"
                     ] .

