PREFIX ex:  <http://example.com/ns#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX sh:  <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

ex:Shape7  a         sh:NodeShape;
        sh:property  [ sh:datatype  xsd:string;
                       sh:maxCount  "1"^^xsd:int;
                       sh:path      <http://example.com/ns#http://www.okkam.org/ontology_restaurant1.owl#street>
                     ];
        sh:property  [ sh:datatype  xsd:string;
                       sh:maxCount  "1"^^xsd:int;
                       sh:path      <http://example.com/ns#http://www.okkam.org/ontology_restaurant1.owl#category>
                     ];
        sh:rule      [ a          sh:TripleRule;
                       sh:select  "PREFIX ex: <http://example.com/ns#>\nPREFIX owl: <http://www.w3.org/2002/07/owl#>\nCONSTRUCT {\n    ?this owl:sameAs ?other .\n}\nWHERE {\n        ?this ex:http://www.okkam.org/ontology_restaurant1.owl#category ?http://www.okkam.org/ontology_restaurant1.owl#category .\n    ?other ex:http://www.okkam.org/ontology_restaurant1.owl#category ?http://www.okkam.org/ontology_restaurant1.owl#category .\n    ?this ex:http://www.okkam.org/ontology_restaurant1.owl#street ?http://www.okkam.org/ontology_restaurant1.owl#street .\n    ?other ex:http://www.okkam.org/ontology_restaurant1.owl#street ?http://www.okkam.org/ontology_restaurant1.owl#street .\n\n    FILTER (?this != ?other)\n}\n"
                     ];
        sh:severity  sh:Violation;
        sh:sparql    [ a           sh:SPARQLConstraint;
                       sh:message  "Duplicate with the same properties must be marked as owl:sameAs.";
                       sh:select   "PREFIX ex: <http://example.com/ns#>\nPREFIX owl: <http://www.w3.org/2002/07/owl#>\nSELECT ?this ?other\nWHERE {\n        ?this ex:http://www.okkam.org/ontology_restaurant1.owl#category ?http://www.okkam.org/ontology_restaurant1.owl#category .\n    ?other ex:http://www.okkam.org/ontology_restaurant1.owl#category ?http://www.okkam.org/ontology_restaurant1.owl#category .\n    ?this ex:http://www.okkam.org/ontology_restaurant1.owl#street ?http://www.okkam.org/ontology_restaurant1.owl#street .\n    ?other ex:http://www.okkam.org/ontology_restaurant1.owl#street ?http://www.okkam.org/ontology_restaurant1.owl#street .\n\n    FILTER (?this != ?other)\n    FILTER NOT EXISTS { ?this owl:sameAs ?other }\n}\n"
                     ];
        sh:sparql    [ a           sh:SPARQLConstraint;
                       sh:message  "Duplicate detected for properties: http://www.okkam.org/ontology_restaurant1.owl#category, http://www.okkam.org/ontology_restaurant1.owl#street";
                       sh:select   "PREFIX ex: <http://example.com/ns#>\nSELECT ?this\nWHERE {\n        ?this ex:http://www.okkam.org/ontology_restaurant1.owl#category ?http://www.okkam.org/ontology_restaurant1.owl#category .\n    ?other ex:http://www.okkam.org/ontology_restaurant1.owl#category ?http://www.okkam.org/ontology_restaurant1.owl#category .\n    ?this ex:http://www.okkam.org/ontology_restaurant1.owl#street ?http://www.okkam.org/ontology_restaurant1.owl#street .\n    ?other ex:http://www.okkam.org/ontology_restaurant1.owl#street ?http://www.okkam.org/ontology_restaurant1.owl#street .\n\n    FILTER (?this != ?other)\n}\n"
                     ];
        sh:target    [ a          sh:SPARQLTarget;
                       sh:select  "PREFIX ex: <http://example.com/ns#>\nSELECT ?this\nWHERE {\n        ?this ex:http://www.okkam.org/ontology_restaurant1.owl#category ?http://www.okkam.org/ontology_restaurant1.owl#category .\n    ?other ex:http://www.okkam.org/ontology_restaurant1.owl#category ?http://www.okkam.org/ontology_restaurant1.owl#category .\n    ?this ex:http://www.okkam.org/ontology_restaurant1.owl#street ?http://www.okkam.org/ontology_restaurant1.owl#street .\n    ?other ex:http://www.okkam.org/ontology_restaurant1.owl#street ?http://www.okkam.org/ontology_restaurant1.owl#street .\n\n    FILTER (?this != ?other)\n}\n"
                     ] .

