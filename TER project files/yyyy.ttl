PREFIX ex:  <http://example.com/ns#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX sh:  <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

ex:Shape2  a         sh:NodeShape;
        sh:property  [ sh:datatype  xsd:string;
                       sh:maxCount  "1"^^xsd:int;
                       sh:path      ex:islocatedininv
                     ];
        sh:rule      [ a          sh:TripleRule;
                       sh:select  "PREFIX ex: <http://example.com/ns#>\nPREFIX owl: <http://www.w3.org/2002/07/owl#>\nCONSTRUCT {\n    ?this owl:sameAs ?other .\n}\nWHERE {\n        ?this ex:islocatedininv ?islocatedininv .\n    ?other ex:islocatedininv ?islocatedininv .\n\n    FILTER (?this != ?other)\n}\n"
                     ];
        sh:severity  sh:Violation;
        sh:sparql    [ a           sh:SPARQLConstraint;
                       sh:message  "Duplicate with the same properties must be marked as owl:sameAs.";
                       sh:select   "PREFIX ex: <http://example.com/ns#>\nPREFIX owl: <http://www.w3.org/2002/07/owl#>\nSELECT ?this ?other\nWHERE {\n        ?this ex:islocatedininv ?islocatedininv .\n    ?other ex:islocatedininv ?islocatedininv .\n\n    FILTER (?this != ?other)\n    FILTER NOT EXISTS { ?this owl:sameAs ?other }\n}\n"
                     ];
        sh:sparql    [ a           sh:SPARQLConstraint;
                       sh:message  "Duplicate detected for properties: islocatedininv";
                       sh:select   "PREFIX ex: <http://example.com/ns#>\nSELECT ?this\nWHERE {\n        ?this ex:islocatedininv ?islocatedininv .\n    ?other ex:islocatedininv ?islocatedininv .\n\n    FILTER (?this != ?other)\n}\n"
                     ];
        sh:target    [ a          sh:SPARQLTarget;
                       sh:select  "PREFIX ex: <http://example.com/ns#>\nSELECT ?this\nWHERE {\n        ?this ex:islocatedininv ?islocatedininv .\n    ?other ex:islocatedininv ?islocatedininv .\n\n    FILTER (?this != ?other)\n}\n"
                     ] .

ex:Shape1  a         sh:NodeShape;
        sh:property  [ sh:datatype  xsd:string;
                       sh:maxCount  "1"^^xsd:int;
                       sh:path      ex:haslength
                     ];
        sh:property  [ sh:datatype  xsd:string;
                       sh:maxCount  "1"^^xsd:int;
                       sh:path      ex:hasheight
                     ];
        sh:property  [ sh:datatype  xsd:string;
                       sh:maxCount  "1"^^xsd:int;
                       sh:path      ex:haslatitude
                     ];
        sh:rule      [ a          sh:TripleRule;
                       sh:select  "PREFIX ex: <http://example.com/ns#>\nPREFIX owl: <http://www.w3.org/2002/07/owl#>\nCONSTRUCT {\n    ?this owl:sameAs ?other .\n}\nWHERE {\n        ?this ex:haslatitude ?haslatitude .\n    ?other ex:haslatitude ?haslatitude .\n    ?this ex:hasheight ?hasheight .\n    ?other ex:hasheight ?hasheight .\n    ?this ex:haslength ?haslength .\n    ?other ex:haslength ?haslength .\n\n    FILTER (?this != ?other)\n}\n"
                     ];
        sh:severity  sh:Violation;
        sh:sparql    [ a           sh:SPARQLConstraint;
                       sh:message  "Duplicate with the same properties must be marked as owl:sameAs.";
                       sh:select   "PREFIX ex: <http://example.com/ns#>\nPREFIX owl: <http://www.w3.org/2002/07/owl#>\nSELECT ?this ?other\nWHERE {\n        ?this ex:haslatitude ?haslatitude .\n    ?other ex:haslatitude ?haslatitude .\n    ?this ex:hasheight ?hasheight .\n    ?other ex:hasheight ?hasheight .\n    ?this ex:haslength ?haslength .\n    ?other ex:haslength ?haslength .\n\n    FILTER (?this != ?other)\n    FILTER NOT EXISTS { ?this owl:sameAs ?other }\n}\n"
                     ];
        sh:sparql    [ a           sh:SPARQLConstraint;
                       sh:message  "Duplicate detected for properties: haslatitude, hasheight, haslength";
                       sh:select   "PREFIX ex: <http://example.com/ns#>\nSELECT ?this\nWHERE {\n        ?this ex:haslatitude ?haslatitude .\n    ?other ex:haslatitude ?haslatitude .\n    ?this ex:hasheight ?hasheight .\n    ?other ex:hasheight ?hasheight .\n    ?this ex:haslength ?haslength .\n    ?other ex:haslength ?haslength .\n\n    FILTER (?this != ?other)\n}\n"
                     ];
        sh:target    [ a          sh:SPARQLTarget;
                       sh:select  "PREFIX ex: <http://example.com/ns#>\nSELECT ?this\nWHERE {\n        ?this ex:haslatitude ?haslatitude .\n    ?other ex:haslatitude ?haslatitude .\n    ?this ex:hasheight ?hasheight .\n    ?other ex:hasheight ?hasheight .\n    ?this ex:haslength ?haslength .\n    ?other ex:haslength ?haslength .\n\n    FILTER (?this != ?other)\n}\n"
                     ] .
