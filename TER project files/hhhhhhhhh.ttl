PREFIX ex:  <http://example.com/ns#>
PREFIX sh:  <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

ex:Shape2  a         sh:NodeShape;
        sh:property  [ sh:datatype  xsd:string;
                       sh:maxCount  "1"^^xsd:int;
                       sh:minCount  "1"^^xsd:int;
                       sh:path      http://purl.org/dc/elements/1.1/creator
                     ];
        sh:rule      [ a          sh:TripleRule;
                       sh:select  "PREFIX ex: <http://example.com/ns#>\nPREFIX owl: <http://www.w3.org/2002/07/owl#>\nCONSTRUCT {\n    ?this owl:sameAs ?other .\n}\nWHERE {\n    ?this http://purl.org/dc/elements/1.1/creator ?creator .\n    ?other http://purl.org/dc/elements/1.1/creator ?creator .\n    FILTER (?this != ?other)\n}\n"
                     ];
        sh:severity  sh:Violation;
        sh:sparql    [ a           sh:SPARQLConstraint;
                       sh:message  "Duplicate detected for properties: creator";
                       sh:select   "PREFIX ex: <http://example.com/ns#>\nSELECT ?this\nWHERE {\n    ?this http://purl.org/dc/elements/1.1/creator ?creator .\n    ?other http://purl.org/dc/elements/1.1/creator ?creator .\n    FILTER (?this != ?other)\n}\n"
                     ];
        sh:sparql    [ a           sh:SPARQLConstraint;
                       sh:message  "Duplicate with the same properties: (creator) must be marked as owl:sameAs.";
                       sh:select   "PREFIX ex: <http://example.com/ns#>\nPREFIX owl: <http://www.w3.org/2002/07/owl#>\nSELECT ?this ?other\nWHERE {\n    ?this http://purl.org/dc/elements/1.1/creator ?creator .\n    ?other http://purl.org/dc/elements/1.1/creator ?creator .\n    FILTER (?this != ?other)\n    FILTER NOT EXISTS { ?this owl:sameAs ?other }\n}\n"
                     ];
        sh:target    [ a          sh:SPARQLTarget;
                       sh:select  "PREFIX ex: <http://example.com/ns#>\nSELECT ?this\nWHERE {\n    ?this http://purl.org/dc/elements/1.1/creator ?creator .\n    ?other http://purl.org/dc/elements/1.1/creator ?creator .\n    FILTER (?this != ?other)\n}\n"
                     ] .

ex:Shape1  a         sh:NodeShape;
        sh:property  [ sh:datatype  xsd:string;
                       sh:maxCount  "1"^^xsd:int;
                       sh:minCount  "1"^^xsd:int;
                       sh:path      http://purl.org/dc/elements/1.1/title
                     ];
        sh:rule      [ a          sh:TripleRule;
                       sh:select  "PREFIX ex: <http://example.com/ns#>\nPREFIX owl: <http://www.w3.org/2002/07/owl#>\nCONSTRUCT {\n    ?this owl:sameAs ?other .\n}\nWHERE {\n    ?this http://purl.org/dc/elements/1.1/title ?title .\n    ?other http://purl.org/dc/elements/1.1/title ?title .\n    FILTER (?this != ?other)\n}\n"
                     ];
        sh:severity  sh:Violation;
        sh:sparql    [ a           sh:SPARQLConstraint;
                       sh:message  "Duplicate detected for properties: title";
                       sh:select   "PREFIX ex: <http://example.com/ns#>\nSELECT ?this\nWHERE {\n    ?this http://purl.org/dc/elements/1.1/title ?title .\n    ?other http://purl.org/dc/elements/1.1/title ?title .\n    FILTER (?this != ?other)\n}\n"
                     ];
        sh:sparql    [ a           sh:SPARQLConstraint;
                       sh:message  "Duplicate with the same properties: (title) must be marked as owl:sameAs.";
                       sh:select   "PREFIX ex: <http://example.com/ns#>\nPREFIX owl: <http://www.w3.org/2002/07/owl#>\nSELECT ?this ?other\nWHERE {\n    ?this http://purl.org/dc/elements/1.1/title ?title .\n    ?other http://purl.org/dc/elements/1.1/title ?title .\n    FILTER (?this != ?other)\n    FILTER NOT EXISTS { ?this owl:sameAs ?other }\n}\n"
                     ];
        sh:target    [ a          sh:SPARQLTarget;
                       sh:select  "PREFIX ex: <http://example.com/ns#>\nSELECT ?this\nWHERE {\n    ?this http://purl.org/dc/elements/1.1/title ?title .\n    ?other http://purl.org/dc/elements/1.1/title ?title .\n    FILTER (?this != ?other)\n}\n"
                     ] .
