PREFIX ex:  <http://example.com/ns#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX sh:  <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

ex:Shape20  a           sh:NodeShape;
        sh:property     [ sh:datatype  xsd:string;
                          sh:maxCount  "1"^^xsd:int;
                          sh:path      ex:isconnectedtoinv
                        ];
        sh:property     [ sh:datatype  xsd:string;
                          sh:maxCount  "1"^^xsd:int;
                          sh:path      ex:wasdestroyedondate
                        ];
        sh:severity     sh:Violation;
        sh:sparql       [ a           sh:SPARQLConstraint;
                          sh:message  "Persons with the same wasdestroyedondate and isconnectedtoinv must be declared as owl:sameAs.";
                          sh:select   "    PREFIX ex: <http://example.com/ns#>\n    PREFIX owl: <http://www.w3.org/2002/07/owl#>\n    SELECT ?this\n    WHERE {\n        ?this ex:wasdestroyedondate ?value ;\n?other ex:wasdestroyedondate ?value ;\n?this ex:isconnectedtoinv ?value ;\n?other ex:isconnectedtoinv ?value ;\n\n        FILTER (?this != ?other)\n        FILTER NOT EXISTS {\n            ?this owl:sameAs ?other .\n        }\n    }\n"
                        ];
        sh:sparql       [ a           sh:SPARQLConstraint;
                          sh:message  "Duplicate wasdestroyedondate and isconnectedtoinv detected within Person class.";
                          sh:select   "    PREFIX ex: <http://example.com/ns#>\n    SELECT ?this\n    WHERE {\n        ?this ex:wasdestroyedondate ?value ;\n?other ex:wasdestroyedondate ?value ;\n?this ex:isconnectedtoinv ?value ;\n?other ex:isconnectedtoinv ?value ;\n\n        FILTER (?this != ?other)\n    }\n"
                        ];
        sh:targetClass  ex:Person .

