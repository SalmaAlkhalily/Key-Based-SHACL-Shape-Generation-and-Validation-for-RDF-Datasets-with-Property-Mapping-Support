                       sh:maxCount  "1"^^xsd:int;
                       sh:path      <street>
                     ];
        sh:severity  sh:Violation;
        sh:sparql    [ a           sh:SPARQLConstraint;
                       sh:message  "Duplicate detected for properties: street, phone_number";
                       sh:select   "SELECT ?this\nWHERE {\n    ?this street ?value .\n    ?other street ?value .\n?this phone_number ?value .\n    ?other phone_number ?value .\n    FILTER (?this != ?other)\n}\n"
                     ] .

