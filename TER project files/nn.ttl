PREFIX sh:  <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<Shape7>  a          sh:NodeShape;
        sh:property  [ sh:datatype  xsd:string;
                       sh:maxCount  "1"^^xsd:int;
                       sh:path      <street>
                     ];
        sh:property  [ sh:datatype  xsd:string;
                       sh:maxCount  "1"^^xsd:int;
                       sh:path      <category>
                     ];
        sh:severity  sh:Violation;
        sh:sparql    [ a           sh:SPARQLConstraint;
                       sh:message  "Duplicate detected for properties: category, street";
                       sh:select   "SELECT ?this\nWHERE {\n    ?this category ?value .\n    ?other category ?value .\n?this street ?value .\n    ?other street ?value .\n    FILTER (?this != ?other)\n}\n"
                     ] .

