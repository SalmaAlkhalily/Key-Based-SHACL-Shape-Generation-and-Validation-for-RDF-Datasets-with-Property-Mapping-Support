PREFIX ex:  <http://example.com/ns#>
PREFIX sh:  <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

ex:Shape20  a        sh:NodeShape;
        sh:property  [ sh:datatype  xsd:string;
                       sh:maxCount  "1"^^xsd:int;
                       sh:minCount  "1"^^xsd:int;
                       sh:path      ex:isconnectedtoinv
                     ];
        sh:property  [ sh:datatype  xsd:string;
                       sh:maxCount  "1"^^xsd:int;
                       sh:minCount  "1"^^xsd:int;
                       sh:path      ex:wasdestroyedondate
                     ];
        sh:rule      [ a          sh:TripleRule;
                       sh:select  "PREFIX ex: <http://example.com/ns#>\nPREFIX owl: <http://www.w3.org/2002/07/owl#>\nCONSTRUCT {\n    ?this owl:sameAs ?other .\n}\nWHERE {\n    ?this ex:wasdestroyedondate ?wasdestroyedondate .\n    ?other ex:wasdestroyedondate ?wasdestroyedondate .?this ex:isconnectedtoinv ?isconnectedtoinv .\n    ?other ex:isconnectedtoinv ?isconnectedtoinv .\n    FILTER (?this != ?other)\n}\n"
                     ];
        sh:severity  sh:Violation;
        sh:sparql    [ a           sh:SPARQLConstraint;
                       sh:message  "Duplicate detected for properties: wasdestroyedondate, isconnectedtoinv";
                       sh:select   "PREFIX ex: <http://example.com/ns#>\nSELECT ?this\nWHERE {\n    ?this ex:wasdestroyedondate ?wasdestroyedondate .\n    ?other ex:wasdestroyedondate ?wasdestroyedondate .?this ex:isconnectedtoinv ?isconnectedtoinv .\n    ?other ex:isconnectedtoinv ?isconnectedtoinv .\n    FILTER (?this != ?other)\n}\n"
                     ];
        sh:sparql    [ a           sh:SPARQLConstraint;
                       sh:message  "Duplicate with the same properties: (wasdestroyedondate, isconnectedtoinv) must be marked as owl:sameAs.";
                       sh:select   "PREFIX ex: <http://example.com/ns#>\nPREFIX owl: <http://www.w3.org/2002/07/owl#>\nSELECT ?this ?other\nWHERE {\n    ?this ex:wasdestroyedondate ?wasdestroyedondate .\n    ?other ex:wasdestroyedondate ?wasdestroyedondate .?this ex:isconnectedtoinv ?isconnectedtoinv .\n    ?other ex:isconnectedtoinv ?isconnectedtoinv .\n    FILTER (?this != ?other)\n    FILTER NOT EXISTS { ?this owl:sameAs ?other }\n}\n"
                     ];
        sh:target    [ a          sh:SPARQLTarget;
                       sh:select  "PREFIX ex: <http://example.com/ns#>\nSELECT ?this\nWHERE {\n    ?this ex:wasdestroyedondate ?wasdestroyedondate .\n    ?other ex:wasdestroyedondate ?wasdestroyedondate .?this ex:isconnectedtoinv ?isconnectedtoinv .\n    ?other ex:isconnectedtoinv ?isconnectedtoinv .\n    FILTER (?this != ?other)\n}\n"
                     ] .

