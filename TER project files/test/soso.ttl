                       sh:minCount  "1"^^xsd:int;
                       sh:path      ex:length
                     ];
        sh:property  [ sh:datatype  xsd:string;
                       sh:maxCount  "1"^^xsd:int;
                       sh:minCount  "1"^^xsd:int;
                       sh:path      ex:latitude
                     ];
        sh:rule      [ a          sh:TripleRule;
                       sh:select  "PREFIX ex: <http://example.com/ns#>\nPREFIX owl: <http://www.w3.org/2002/07/owl#>\nCONSTRUCT {\n    ?this owl:sameAs ?other .\n}\nWHERE {\n    ?this ex:latitude ?latitude .\n    ?other ex:latitude ?latitude .?this ex:length ?length .\n    ?other ex:length ?length .?this ex:createdinv ?createdinv .\n    ?other ex:createdinv ?createdinv .\n    FILTER (?this != ?other)\n}\n"
                     ];
        sh:severity  sh:Violation;
        sh:sparql    [ a           sh:SPARQLConstraint;
                       sh:message  "Duplicate detected for properties: latitude, length, createdinv";
                       sh:select   "PREFIX ex: <http://example.com/ns#>\nSELECT ?this\nWHERE {\n    ?this ex:latitude ?latitude .\n    ?other ex:latitude ?latitude .?this ex:length ?length .\n    ?other ex:length ?length .?this ex:createdinv ?createdinv .\n    ?other ex:createdinv ?createdinv .\n    FILTER (?this != ?other)\n}\n"
                     ];
        sh:sparql    [ a           sh:SPARQLConstraint;
                       sh:message  "Duplicate with the same properties: (latitude, length, createdinv) must be marked as owl:sameAs.";
                       sh:select   "PREFIX ex: <http://example.com/ns#>\nPREFIX owl: <http://www.w3.org/2002/07/owl#>\nSELECT ?this ?other\nWHERE {\n    ?this ex:latitude ?latitude .\n    ?other ex:latitude ?latitude .?this ex:length ?length .\n    ?other ex:length ?length .?this ex:createdinv ?createdinv .\n    ?other ex:createdinv ?createdinv .\n    FILTER (?this != ?other)\n    FILTER NOT EXISTS { ?this owl:sameAs ?other }\n}\n"
                     ];
        sh:target    [ a          sh:SPARQLTarget;
                       sh:select  "PREFIX ex: <http://example.com/ns#>\nSELECT ?this\nWHERE {\n    ?this ex:latitude ?latitude .\n    ?other ex:latitude ?latitude .?this ex:length ?length .\n    ?other ex:length ?length .?this ex:createdinv ?createdinv .\n    ?other ex:createdinv ?createdinv .\n    FILTER (?this != ?other)\n}\n"
                     ] .

ex:Shape38  a        sh:NodeShape;
        sh:property  [ sh:datatype  xsd:string;
