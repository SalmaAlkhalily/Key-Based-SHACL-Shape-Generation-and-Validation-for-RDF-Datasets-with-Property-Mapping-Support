<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.fxmisc.flowless.VirtualizedScrollPane?>
<?import org.fxmisc.richtext.StyleClassedTextArea?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>


<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.myfirstpro.Tab1Controller" spacing="15" style="-fx-padding: 20;">
    <Label text="Generate Keys for RDF File" style="-fx-font-size: 18px; -fx-text-fill: #333;"/>
    <Separator/>

    <VBox spacing="10">
        <HBox spacing="10">
            <Button onAction="#openRdfFileChooser" text="Select RDF NT File"
                    style="-fx-base: #0078d7; -fx-text-fill: white;"/>
        </HBox>

        <Label text="Selected RDF File Content:"/>
        <VirtualizedScrollPane>
            <content>
                <StyleClassedTextArea fx:id="rdfContentTextArea" wrapText="true"
                                      style="-fx-control-inner-background: #f9f9f9; -fx-border-color: #ddd; -fx-border-width: 1px;"/>
            </content>
        </VirtualizedScrollPane>

        <HBox spacing="10">
            <Button fx:id="generateKeysButton" disable="true" onAction="#generateKeys" text="Generate Keys"
                    style="-fx-base: #4caf50; -fx-text-fill: white;"/>
            <Button fx:id="saveKeysButton" disable="true" onAction="#saveGeneratedKeysToFile" text="Save Keys"
                    style="-fx-base: #0078d7; -fx-text-fill: white;"/>
        </HBox>

        <Label text="Generated Keys Output:"/>
        <VirtualizedScrollPane>
            <content>
                <StyleClassedTextArea fx:id="outputTextArea" wrapText="true"
                                      style="-fx-control-inner-background: #f9f9f9; -fx-border-color: #ddd; -fx-border-width: 1px;"/>
            </content>
        </VirtualizedScrollPane>
    </VBox>

    <ProgressIndicator fx:id="loadingIndicator" visible="false" style="-fx-progress-color: #4caf50;"/>
</VBox>