<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.fxmisc.flowless.VirtualizedScrollPane?>
<?import org.fxmisc.richtext.StyleClassedTextArea?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>


<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.myfirstpro.Tab3Controller" style="-fx-padding: 20;">
    <Label text="Validate RDF Data Against SHACL Shapes" style="-fx-font-size: 18px; -fx-text-fill: #333;"/>
    <Separator/>

    <VBox>
        <HBox>
            <Button fx:id="chooseDataFileButton" onAction="#chooseDataFile" text="Choose Data File"
                    style="-fx-base: #0078d7; -fx-text-fill: white;"/>
        </HBox>

        <Label text="Data File Content:"/>
        <VirtualizedScrollPane>
            <content>
                <StyleClassedTextArea fx:id="dataFileTextArea" wrapText="true"
                                      style="-fx-control-inner-background: #f9f9f9; -fx-border-color: #ddd; -fx-border-width: 1px;"/>
            </content>
        </VirtualizedScrollPane>

        <VBox fx:id="equivVboxValidate" visible="false" managed="false" spacing="NaN">
            <HBox alignment="TOP_LEFT">
                <Button fx:id="chooseEquivFileBtnValidate" onAction="#chooseMappingFileValidate" prefHeight="26.0"
                        prefWidth="156.0"
                        text="Choose Mapping File" style="-fx-base: #0078d7; -fx-text-fill: white;"/>

            </HBox>
            <Label text="Mapping File Content:"/>
            <VirtualizedScrollPane>
                <content>
                    <StyleClassedTextArea fx:id="mappingTextAreaValidate" wrapText="true"
                                          style="-fx-control-inner-background: #f9f9f9; -fx-border-color: #ddd; -fx-border-width: 1px;"/>
                </content>
            </VirtualizedScrollPane>
        </VBox>

        <HBox spacing="10">
            <Button fx:id="chooseShapesFileButton" onAction="#chooseShapesFile" text="Choose Shapes File"
                    style="-fx-base: #0078d7; -fx-text-fill: white;"/>
        </HBox>

        <Label text="Shapes File Content:"/>
        <VirtualizedScrollPane>
            <content>
                <StyleClassedTextArea fx:id="shapesFileTextArea" wrapText="true"
                                      style="-fx-control-inner-background: #f9f9f9; -fx-border-color: #ddd; -fx-border-width: 1px;"/>
            </content>
        </VirtualizedScrollPane>

        <HBox spacing="10">
            <Button fx:id="validateButton" disable="true" onAction="#validate" text="Validate"
                    style="-fx-base: #4caf50; -fx-text-fill: white;"/>
        </HBox>

        <Label text="Validation Output:"/>
        <VirtualizedScrollPane>
            <content>
                <StyleClassedTextArea fx:id="validateTextArea" wrapText="true"
                                      style="-fx-control-inner-background: #f9f9f9; -fx-border-color: #ddd; -fx-border-width: 1px;"/>
            </content>
        </VirtualizedScrollPane>
        <HBox spacing="10">
            <Button fx:id="downloadReportButton" onAction="#downloadReport" disable="true"
                    text="Download Validation Report"
                    style="-fx-base: #0078d7; -fx-text-fill: white;"/>
        </HBox>
    </VBox>

    <ProgressIndicator fx:id="validationLoadingIndicator" visible="false" style="-fx-progress-color: #4caf50;"/>
</VBox>