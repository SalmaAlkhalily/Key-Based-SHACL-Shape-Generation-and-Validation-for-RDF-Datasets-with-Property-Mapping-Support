PREFIX ex:  <http://example.com/ns#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX sh:  <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

ex:Shape2  a         sh:NodeShape;
        sh:property  [ sh:datatype  xsd:string;
                       sh:maxCount  "1"^^xsd:int;
                       sh:path      ex:located_
                     ];
        sh:rule      [ a          sh:TripleRule;
                       sh:select  "PREFIX ex: <http://example.com/ns#>\nPREFIX owl: <http://www.w3.org/2002/07/owl#>\nCONSTRUCT {\n    ?this owl:sameAs ?other .\n}\nWHERE {\n        ?this ex:located_ ?located_ .\n    ?other ex:located_ ?located_ .\n\n    FILTER (?this != ?other)\n}\n"
                     ];
        sh:severity  sh:Violation;
        sh:sparql    [ a           sh:SPARQLConstraint;
                       sh:message  "Duplicate with the same properties must be marked as owl:sameAs.";
                       sh:select   "PREFIX ex: <http://example.com/ns#>\nPREFIX owl: <http://www.w3.org/2002/07/owl#>\nSELECT ?this ?other\nWHERE {\n        ?this ex:located_ ?located_ .\n    ?other ex:located_ ?located_ .\n\n    FILTER (?this != ?other)\n    FILTER NOT EXISTS { ?this owl:sameAs ?other }\n}\n"
                     ];
        sh:sparql    [ a           sh:SPARQLConstraint;
                       sh:message  "Duplicate detected for properties: located_";
                       sh:select   "PREFIX ex: <http://example.com/ns#>\nSELECT ?this\nWHERE {\n        ?this ex:located_ ?located_ .\n    ?other ex:located_ ?located_ .\n\n    FILTER (?this != ?other)\n}\n"
                     ];
        sh:target    [ a          sh:SPARQLTarget;
                       sh:select  "PREFIX ex: <http://example.com/ns#>\nSELECT ?this\nWHERE {\n        ?this ex:located_ ?located_ .\n    ?other ex:located_ ?located_ .\n\n    FILTER (?this != ?other)\n}\n"
                     ] .

ex:Shape1  a         sh:NodeShape;
        sh:property  [ sh:datatype  xsd:string;
                       sh:maxCount  "1"^^xsd:int;
                       sh:path      ex:length_
                     ];
        sh:property  [ sh:datatype  xsd:string;
                       sh:maxCount  "1"^^xsd:int;
                       sh:path      ex:height_
                     ];
        sh:property  [ sh:datatype  xsd:string;
                       sh:maxCount  "1"^^xsd:int;
                       sh:path      ex:latitude_
                     ];
        sh:rule      [ a          sh:TripleRule;
                       sh:select  "PREFIX ex: <http://example.com/ns#>\nPREFIX owl: <http://www.w3.org/2002/07/owl#>\nCONSTRUCT {\n    ?this owl:sameAs ?other .\n}\nWHERE {\n        ?this ex:latitude_ ?latitude_ .\n    ?other ex:latitude_ ?latitude_ .\n    ?this ex:height_ ?height_ .\n    ?other ex:height_ ?height_ .\n    ?this ex:length_ ?length_ .\n    ?other ex:length_ ?length_ .\n\n    FILTER (?this != ?other)\n}\n"
                     ];
        sh:severity  sh:Violation;
        sh:sparql    [ a           sh:SPARQLConstraint;
                       sh:message  "Duplicate with the same properties must be marked as owl:sameAs.";
                       sh:select   "PREFIX ex: <http://example.com/ns#>\nPREFIX owl: <http://www.w3.org/2002/07/owl#>\nSELECT ?this ?other\nWHERE {\n        ?this ex:latitude_ ?latitude_ .\n    ?other ex:latitude_ ?latitude_ .\n    ?this ex:height_ ?height_ .\n    ?other ex:height_ ?height_ .\n    ?this ex:length_ ?length_ .\n    ?other ex:length_ ?length_ .\n\n    FILTER (?this != ?other)\n    FILTER NOT EXISTS { ?this owl:sameAs ?other }\n}\n"
                     ];
        sh:sparql    [ a           sh:SPARQLConstraint;
                       sh:message  "Duplicate detected for properties: latitude_, height_, length_";
                       sh:select   "PREFIX ex: <http://example.com/ns#>\nSELECT ?this\nWHERE {\n        ?this ex:latitude_ ?latitude_ .\n    ?other ex:latitude_ ?latitude_ .\n    ?this ex:height_ ?height_ .\n    ?other ex:height_ ?height_ .\n    ?this ex:length_ ?length_ .\n    ?other ex:length_ ?length_ .\n\n    FILTER (?this != ?other)\n}\n"
                     ];
        sh:target    [ a          sh:SPARQLTarget;
                       sh:select  "PREFIX ex: <http://example.com/ns#>\nSELECT ?this\nWHERE {\n        ?this ex:latitude_ ?latitude_ .\n    ?other ex:latitude_ ?latitude_ .\n    ?this ex:height_ ?height_ .\n    ?other ex:height_ ?height_ .\n    ?this ex:length_ ?length_ .\n    ?other ex:length_ ?length_ .\n\n    FILTER (?this != ?other)\n}\n"
                     ] .
