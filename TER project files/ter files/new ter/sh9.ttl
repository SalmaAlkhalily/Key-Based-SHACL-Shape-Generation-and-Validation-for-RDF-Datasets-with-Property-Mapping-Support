        sh:SPARQLConstraint  [ a              sh:SPARQLConstraint;
                               sh:message     "Duplicate detected for properties: ";
                               sh:resultPath  ex:;
                               sh:select      "    PREFIX ex: <http://example.com/ns#>\n    SELECT ?this\n    WHERE {\n        ?this ex: ?value .\n        ?other ex: ?value .\n        FILTER (?this != ?other)  // Ensure duplicates across different resources\n    }\n"
                             ];
        sh:property          [ sh:datatype  xsd:string;
