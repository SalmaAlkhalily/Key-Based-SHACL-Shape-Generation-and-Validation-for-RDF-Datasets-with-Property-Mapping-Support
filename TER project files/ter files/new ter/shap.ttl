@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.com/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

ex:Shape2  a                 sh:NodeShape;
        sh:SPARQLConstraint  [ a              sh:SPARQLConstraint;
                               sh:message     "Duplicate detected for properties: isLocatedInINV";
                               sh:resultPath  ex:isLocatedInINV;
                               sh:select      "    PREFIX ex: <http://example.com/ns#>\n    SELECT ?this\n    WHERE {\n        ?this ex:isLocatedInINV ?isLocatedInINV .\n        ?other ex:isLocatedInINV ?isLocatedInINV ;  .\n        FILTER (?this != ?other)\n    }\n"
                             ];
        sh:property          [ sh:datatype  xsd:string;
                               sh:maxCount  "1"^^xsd:int;
                               sh:path      ex:isLocatedInINV
                             ];
        sh:severity          sh:Violation;
        sh:target            [ a          sh:SPARQLTarget;
                               sh:select  "    PREFIX ex: <http://example.com/ns#>\n    SELECT ?node\n    WHERE {\n        ?node ex:isLocatedInINV ?value .\n    }\n"
                             ] .
