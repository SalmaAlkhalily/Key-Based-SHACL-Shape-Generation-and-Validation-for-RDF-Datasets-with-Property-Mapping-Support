ex:Shape20  a        sh:NodeShape;
        sh:property  [ sh:path  ex:isconnectedtoinv ];
        sh:property  [ sh:path  ex:wasdestroyedondate ];
        sh:severity  sh:Violation;
        sh:sparql    [ a           sh:SPARQLConstraint;
                       sh:message  "Duplicate detected for combination of properties: wasdestroyedondate, isconnectedtoinv";
                       sh:select   "PREFIX ex: <http://example.com/ns#>\nSELECT ?this\nWHERE {\n  ?this ex:wasdestroyedondate ex:isconnectedtoinv ?wasdestroyedondate ?isconnectedtoinv .\n?other ex:wasdestroyedondate ex:isconnectedtoinv ?wasdestroyedondate ?isconnectedtoinv .\nFILTER (?this != ?other && ?this ex:wasdestroyedondate ?wasdestroyedondate && ?other ex:wasdestroyedondate ?wasdestroyedondate && ?this ex:isconnectedtoinv ?isconnectedtoinv && ?other ex:isconnectedtoinv ?isconnectedtoinv)\n\n}\n"
                     ];
        sh:target    [ a          sh:SPARQLTarget;
                       sh:select  "PREFIX ex: <http://example.com/ns#>\nSELECT DISTINCT ?node WHERE {\n  ?node ex:wasdestroyedondate ex:isconnectedtoinv ?value .\n}\n"
                     ] .

