PREFIX ex:  <http://example.com/ns#>
PREFIX sh:  <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

ex:Shape20  a        sh:NodeShape;
        sh:property  [ sh:path  ex:isconnectedtoinv ];
        sh:property  [ sh:path  ex:wasdestroyedondate ];
        sh:severity  sh:Violation;
        sh:sparql    [ a           sh:SPARQLConstraint;
                       sh:message  "Duplicate detected for combination of properties: wasdestroyedondate, isconnectedtoinv";
                       sh:select   "PREFIX ex: <http://example.com/ns#>\nSELECT ?this\nWHERE {\n  ?this ex:wasdestroyedondate ?wasdestroyedondate .\n?other ex:wasdestroyedondate ?wasdestroyedondate .\n?this ex:isconnectedtoinv ?isconnectedtoinv .\n?other ex:isconnectedtoinv ?isconnectedtoinv .\nFILTER (?this != ?other && ?this ex:wasdestroyedondate ?wasdestroyedondate && ?other ex:wasdestroyedondate ?wasdestroyedondate && ?this ex:isconnectedtoinv ?isconnectedtoinv && ?other ex:isconnectedtoinv ?isconnectedtoinv)\n}\n"
                     ];
        sh:target    [ a          sh:SPARQLTarget;
                       sh:select  "PREFIX ex: <http://example.com/ns#>\nSELECT DISTINCT ?node WHERE {\n  ?node ex:wasdestroyedondate ?value .\n  ?node ex:isconnectedtoinv ?value .\n}"
                     ] .

