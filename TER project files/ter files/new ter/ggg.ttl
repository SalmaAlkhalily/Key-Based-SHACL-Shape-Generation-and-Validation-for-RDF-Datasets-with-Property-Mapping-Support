PREFIX ex:  <http://example.com/ns#>
PREFIX sh:  <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

ex:Shape20  a                sh:NodeShape;
        sh:SPARQLConstraint  [ a              sh:SPARQLConstraint;
                               sh:message     "Duplicate detected for properties: wasdestroyedondate, isconnectedtoinv";
                               sh:resultPath  ex:wasdestroyedondate;
                               sh:select      "    PREFIX ex: <http://example.com/ns#>\n    SELECT ?this\n    WHERE {\n        ?this ex:wasdestroyedondate ?value .\n        ?other ex:wasdestroyedondate ?value .\n        FILTER (?this != ?other)  // Ensure duplicates across different resources\n    }\n"
                             ];
        sh:property          [ sh:datatype  xsd:string;
                               sh:maxCount  "1"^^xsd:int;
                               sh:path      ex:isconnectedtoinv
                             ];
        sh:property          [ sh:datatype  xsd:string;
                               sh:maxCount  "1"^^xsd:int;
                               sh:path      ex:wasdestroyedondate
                             ];
        sh:severity          sh:Violation;
        sh:target            [ a          sh:SPARQLTarget;
                               sh:select  "    PREFIX ex: <http://example.com/ns#>\n    SELECT ?node\n    WHERE {\n        ?node ex:wasdestroyedondate ?value .\n    }\n"
                             ] .

