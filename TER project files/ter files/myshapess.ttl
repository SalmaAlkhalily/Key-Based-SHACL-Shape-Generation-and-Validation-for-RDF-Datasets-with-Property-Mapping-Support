@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.com/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

ex:Shape1
    a sh:NodeShape ;
    sh:targetClass ex:TargetClass ;

    sh:property [
        sh:path ex:haslatitude ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path ex:hasheight ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path ex:haslength ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Duplicate detected for properties: haslatitude, hasheight, haslength" ;
        sh:select """
            PREFIX ex: <http://example.com/ns#>
            SELECT ?this
            WHERE {
                ?this ex:haslatitude ?haslatitude .
                ?this ex:hasheight ?hasheight .
                ?this ex:haslength ?haslength .
                ?other ex:haslatitude ?haslatitude ; ex:hasheight ?hasheight ; ex:haslength ?haslength ;  .
                FILTER (?this != ?other)
            }
        """ ;
    ] .

