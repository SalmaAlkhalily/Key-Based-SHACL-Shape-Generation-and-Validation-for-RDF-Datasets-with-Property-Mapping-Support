                       sh:select  "PREFIX ex: <http://example.com/ns#>\nPREFIX owl: <http://www.w3.org/2002/07/owl#>\nCONSTRUCT {\n    ?this owl:sameAs ?other .\n}\nWHERE {\n        ?this ex:haslatitude ?haslatitude; ex:wasdestroyedondate ?wasdestroyedondate; ex:wascreatedondate ?wascreatedondate.\n    ?other ex:haslatitude ?haslatitude; ex:wasdestroyedondate ?wasdestroyedondate; ex:wascreatedondate ?wascreatedondate.\n\n    FILTER (?this != ?other)\n}\n"
